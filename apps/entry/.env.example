# The entry point has no auth gate and no agent dependency — it is never
# authenticated, so it needs none of the AUTH_SESSION_PASSWORD / DEMO_AUTH_*
# values the two app surfaces require.
#
# Copy to .env.local only if you need to override a default.

# Public origin, used for sitemap/robots. Defaults to http://localhost:3003.
# NEXT_PUBLIC_APP_URL="https://artloupestudio.com"

# Server log level: fatal | error | warn | info | debug | trace
# LOG_LEVEL="info"

# --- Launch panels + the acknowledgement gate --------------------------------
#
# Origins of the app surfaces. These are both the panel hrefs and the
# allowlist the `?next=` handoff is validated against, so a surface cannot become
# launchable without also becoming a legal redirect target.
# Default to the dev ports below, so a fresh clone runs with no .env.local.
# NEXT_PUBLIC_STUDIO_URL="https://studio.artloupestudio.com"     # dev: http://localhost:3001
# NEXT_PUBLIC_OPERATIONS_URL="https://ops.artloupestudio.com"    # dev: http://localhost:3000

# `Domain` for the acknowledgement cookie, so all subdomains can read what
# the apex sets. LEAVE THIS UNSET IN DEVELOPMENT. Cookies ignore the port, so the
# three surfaces already share one jar on localhost as a host-only cookie; setting
# a literal domain there makes the browser reject the Set-Cookie outright and the
# gate silently never engages.
# ACK_COOKIE_DOMAIN=".artloupestudio.com"
