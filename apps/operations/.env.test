# End-to-end test credentials. NOT secrets — this file is committed on purpose.
#
# Why this file exists rather than Playwright's `webServer.env`: Next's `@next/env`
# overwrites externally-set `process.env` values with `.env.local` on first load, so
# a developer's local credentials silently won over the suite's and login failed.
# CI has no `.env.local`, so that failed only on configured machines — the worst
# shape of bug. Next skips `.env.local` entirely when NODE_ENV=test, which is why
# the Playwright web server sets it.
AUTH_SESSION_PASSWORD="e2e-demo-session-password-0123456789"

# Hermetic auth: the demo provider stands in for Supabase so the suite needs no live
# GoTrue. Email-shaped because the login field is type="email". The demo provider
# resolves to `superuser`, which the console's allowed roles include.
AUTH_PROVIDER="demo"
DEMO_AUTH_USERNAME="demo@demo.artloupestudio.com"
DEMO_AUTH_PASSWORD="demo-pass"
DISABLE_HTTPS_UPGRADE="true"
