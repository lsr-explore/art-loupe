{
  "name": "@artloupe/operations",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "analyze": "ANALYZE=true next experimental-analyze",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "i18n:check": "i18n-check --locales messages --source en --format next-intl",
    "i18n:check:unused": "i18n-check --locales messages --source en --format next-intl --only missingKeys,invalidKeys,unused --unused src",
    "size": "size-limit"
  },
  "dependencies": {
    "@artloupe/auth": "workspace:*",
    "@artloupe/fascia": "workspace:*",
    "@artloupe/schemas": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.4.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.63.0",
    "size-limit": "^14.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0",
    "vitest-canvas-mock": "^1.2.0"
  },
  "size-limit": [
    {
      "name": "JS (First Load)",
      "path": ".next/static/chunks/**/*.js",
      "limit": "300 kB",
      "gzip": true
    },
    {
      "name": "CSS",
      "path": ".next/static/chunks/**/*.css",
      "limit": "30 kB",
      "gzip": true
    }
  ]
}
