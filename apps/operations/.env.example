# Auth (@artloupe/auth) — copy to .env.local and set real values.
# Operations signs operators in with Supabase email/password; see packages/auth/README.md.

# local | ci | production. Defaults to local. With production, server secrets are read only from
# mounted files, never from this file or the environment. Any other value fails the first request
# that reads a secret, which includes every request the auth proxy checks.
# APP_ENV="local"

# iron-session cookie encryption key — MUST be at least 32 characters. A secret: a mounted file
# (AUTH_SESSION_PASSWORD_FILE, or /run/secrets/auth_session_password) wins over this value, and
# with APP_ENV=production this value is ignored and only the file is read.
AUTH_SESSION_PASSWORD="change-me-to-a-random-string-at-least-32-chars"

# Session lifetime in seconds. Deliberately shorter than the studio's 8-hour default:
# this surface carries cost and eval data, and its sessions should not outlast a shift.
AUTH_SESSION_TTL="3600"

# Auth provider: "supabase" (default, operator email/password) or "demo", for the hermetic e2e
# run only. Nothing at runtime refuses "demo" — a NODE_ENV guard cannot work, because Next
# inlines NODE_ENV at build time — so never set it in development or a deployment. Even a demo
# session must still carry the operator role.
# AUTH_PROVIDER="supabase"

# Supabase Auth — local values come from `pnpm supabase status` (or the CLI's
# `status -o env`). The anon key is safe here; NEVER put the service-role key in app
# env (only scripts/seed/seed-demo-accounts.sh uses it, read at runtime).
#
# Seed an operator with `./scripts/seed/seed-demo-accounts.sh`, which writes
# `app_metadata.artloupe_role = "operator"`. Only that role (or superuser) may sign in
# here; an artist account is refused at login and never receives a session.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="change-me-local-anon-key"

# Demo-only credential, used when AUTH_PROVIDER="demo".
DEMO_AUTH_USERNAME="demo@demo.artloupestudio.com"
DEMO_AUTH_PASSWORD="demo-pass"

# Agent endpoint for the cost panel and run health (GET /ops/costs and /ops/runs). Unset by
# default, so CI and e2e stay hermetic and the dashboard says the data is unavailable. The app
# forwards the operator's own token and holds no database credential. Outside production, plain
# HTTP is accepted only for localhost or 127.0.0.1; anything else must be HTTPS.
# ARTLOUPE_AGENT_URL="http://127.0.0.1:8080"

# Public origin of this surface — used for metadataBase, sitemap, and robots.
# Defaults to http://localhost:3000.
# NEXT_PUBLIC_APP_URL="https://ops.artloupestudio.com"

# Origin of the entry-point surface, which hosts the one canonical About site the
# shared footer links to. Defaults to http://localhost:3003.
# NEXT_PUBLIC_ENTRY_URL="https://artloupestudio.com"

# Server log level: fatal | error | warn | info | debug | trace
# LOG_LEVEL="info"
