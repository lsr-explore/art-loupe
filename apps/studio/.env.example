# Auth (@artloupe/auth) — copy to .env.local and set real values.
# Studio auth is Supabase email/password; see packages/auth/README.md.

# local | ci | production. Defaults to local. With production, server secrets are read only from
# mounted files, never from this file or the environment. Any other value fails the first request
# that reads a secret, which includes every request the auth proxy checks.
# APP_ENV="local"

# iron-session cookie encryption key — MUST be at least 32 characters. A secret: a mounted file
# (AUTH_SESSION_PASSWORD_FILE, or /run/secrets/auth_session_password) wins over this value, and
# with APP_ENV=production this value is ignored and only the file is read.
AUTH_SESSION_PASSWORD="change-me-to-a-random-string-at-least-32-chars"

# Session lifetime in seconds. Defaults to 8 hours when unset. Sealed inside the
# encrypted cookie, so the server decides expiry and a client cannot extend it.
# AUTH_SESSION_TTL="28800"

# Auth provider: "supabase" (default, artist email/password) or "demo" (single
# super-user, for the hermetic e2e run only — never set it in development or a deployment).
# When "supabase", the two SUPABASE_* vars below are required or login fails closed.
# AUTH_PROVIDER="supabase"

# Supabase Auth — local values come from `pnpm supabase status` (or the CLI's
# `status -o env`). The anon key is safe here; NEVER put the service-role key in
# app env (only scripts/seed/seed-demo-accounts.sh uses it, read at runtime).
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="change-me-local-anon-key"

# Demo-only credential (used when AUTH_PROVIDER="demo"). Email-shaped because the
# login field is type="email".
DEMO_AUTH_USERNAME="demo@demo.artloupestudio.com"
DEMO_AUTH_PASSWORD="change-me"

# The Python agent: analysis runs and their progress stream, Get Inspired, and the learning
# assistant. Unset, each of those routes answers 503. Outside production, plain HTTP is
# accepted only for localhost or 127.0.0.1; anything else must be an HTTPS Cloud Run origin
# (*.run.app), which the studio calls with a Google identity token.
ARTLOUPE_AGENT_URL="http://127.0.0.1:8080"

# Deployment only: the GCP workload identity provider audience and the invoker service-account
# email the studio uses to mint that identity token.
# GCP_WIF_AUDIENCE="//iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER"
# GCP_SERVICE_ACCOUNT="studio-invoker@PROJECT.iam.gserviceaccount.com"

# Public origin of this surface — used for metadataBase, sitemap, and robots.
# Defaults to http://localhost:3001.
# NEXT_PUBLIC_APP_URL="https://studio.artloupestudio.com"

# Origin of the entry-point surface, which hosts the one canonical About site the
# shared footer links to. Defaults to http://localhost:3003.
# NEXT_PUBLIC_ENTRY_URL="https://artloupestudio.com"

# Server log level: fatal | error | warn | info | debug | trace
# LOG_LEVEL="info"
