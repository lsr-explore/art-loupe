# Auth (@artloupe/auth) — copy to .env.local and set real values.
# Studio auth is Supabase email/password; see packages/auth/README.md.

# iron-session cookie encryption key — MUST be at least 32 characters.
AUTH_SESSION_PASSWORD="change-me-to-a-random-string-at-least-32-chars"

# Session lifetime in seconds. Defaults to 8 hours when unset. Sealed inside the
# encrypted cookie, so the server decides expiry and a client cannot extend it.
# AUTH_SESSION_TTL="28800"

# Auth provider: "supabase" (default, artist email/password) or "demo" (single
# super-user; hermetic e2e and Docker-free local runs). When "supabase", the two
# SUPABASE_* vars below are required or login fails closed.
# AUTH_PROVIDER="supabase"

# Supabase Auth — local values come from `pnpm supabase status` (or the CLI's
# `status -o env`). The anon key is safe here; NEVER put the service-role key in
# app env (only scripts/seed/seed-demo-accounts.sh uses it, read at runtime).
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="change-me-local-anon-key"

# Demo-only credential (used when AUTH_PROVIDER="demo"). Email-shaped because the
# login field is type="email".
DEMO_AUTH_USERNAME="demo@demo.artloupestudio.com"
DEMO_AUTH_PASSWORD="change-me"

# Live agent (optional). When set, the studio POSTs critique requests to the Python
# agent at this URL. When UNSET, the UI falls back to committed fixtures, so it runs
# with no Python stack and CI/e2e stay hermetic.
# ARTLOUPE_AGENT_URL="http://127.0.0.1:8080"

# Public origin of this surface — used for metadataBase, sitemap, and robots.
# Defaults to http://localhost:3001.
# NEXT_PUBLIC_APP_URL="https://studio.artloupestudio.com"

# Origin of the entry-point surface, which hosts the one canonical About site the
# shared footer links to. Defaults to http://localhost:3003.
# NEXT_PUBLIC_ENTRY_URL="https://artloupestudio.com"
