{
  "name": "@artloupe/fascia",
  "version": "0.0.0",
  "private": true,
  "description": "Art Loupe shared UI primitives \u2014 the visible, crafted surface (shadcn/base-ui components, design tokens, utilities).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
