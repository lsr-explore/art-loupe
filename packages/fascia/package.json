    "./components/blocks/theme-toggle": "./src/components/blocks/theme-toggle.tsx",
    "./components/blocks/user-chip": "./src/components/blocks/user-chip.tsx",
    "./i18n/locales": "./src/i18n/locales.ts",
    "./styles/print.css": "./src/styles/print.css"
  },
  "scripts": {
    "i18n:check": "i18n-check --locales messages --source en --format next-intl",
    "i18n:check:unused": "i18n-check --locales messages --source en --format next-intl --only missingKeys,invalidKeys,unused --unused src --next-intl-translation-fn-type-alias Translate",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "typescript": "^6",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "vitest-canvas-mock": "^1.1.4"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
