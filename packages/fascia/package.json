    "./components/blocks/demo-banner": "./src/components/blocks/demo-banner.tsx",
    "./components/blocks/landing-hero": "./src/components/blocks/landing-hero.tsx",
    "./components/blocks/language-select": "./src/components/blocks/language-select.tsx",
    "./components/blocks/link-component": "./src/components/blocks/link-component.ts",
    "./components/blocks/login-card": "./src/components/blocks/login-card.tsx",
    "./components/blocks/login-form": "./src/components/blocks/login-form.tsx",
