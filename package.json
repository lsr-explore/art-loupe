{
  "name": "art-loupe",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "------------------- dev -------------------": "noop",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:operations": "pnpm --filter @artloupe/operations dev",
    "dev:studio": "pnpm --filter @artloupe/studio dev",
    "dev:entry": "pnpm --filter @artloupe/entry dev",
    "build": "pnpm --filter './apps/*' build",
    "analyze": "pnpm --filter './apps/*' analyze",
    "tree": "tree -L 3 -I 'node_modules|coverage|.next|playwright-report|test-results|storybook-static'",
    "------------------- code quality -------------------": "noop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint '**/*.css' --fix",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md'",
    "lint:prose": "vale README.md docs apps/*/README.md packages/*/README.md python/README.md supabase/README.md apps/*/src apps/*/e2e packages/*/src python/libs",
    "typecheck": "pnpm -r typecheck",
    "i18n:check": "pnpm -r --if-present i18n:check",
    "i18n:check:unused": "pnpm -r --if-present --no-bail i18n:check:unused",
    "check:all": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm lint:md && pnpm i18n:check && pnpm traceability:check && pnpm contrast:check && pnpm typecheck && pnpm test",
    "------------------- metrics -------------------": "noop",
    "session-metrics:report": "node scripts/reports/session-metrics-report.mjs",
    "backlog:report": "node scripts/reports/backlog-report.mjs",
    "contrast:report": "node scripts/reports/contrast-report.mjs",
    "contrast:check": "node scripts/reports/contrast-report.mjs --check",
    "contrast:check:strict": "node scripts/reports/contrast-report.mjs --check --strict",
    "traceability:report": "node scripts/reports/traceability-report.mjs",
    "traceability:check": "node scripts/reports/traceability-report.mjs --check",
    "traceability:fix": "node scripts/reports/traceability-report.mjs --fix",
    "traceability:run": "node scripts/reports/traceability-report.mjs --run",
    "------------------- testing -------------------": "noop",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --if-present --parallel test:watch",
    "test:coverage": "pnpm -r --if-present --reporter=append-only test:coverage",
    "------------------- e2e -------------------": "noop",
    "e2e:ui:operations": "pnpm --filter @artloupe/operations e2e:ui",
    "e2e:ui:studio": "pnpm --filter @artloupe/studio e2e:ui",
    "e2e:ui:entry": "pnpm --filter @artloupe/entry e2e:ui",
    "e2e": "pnpm -r --if-present e2e",
    "------------------- static analysis -------------------": "noop",
    "depcruise": "depcruise apps packages --config .dependency-cruiserrc.mjs",
    "circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.base.json apps/ packages/",
    "depcruise:graph": "depcruise apps packages --include-only '(apps|packages)/[^/]+/src' --config .dependency-cruiserrc.mjs --output-type dot | dot -T svg | depcruise-wrap-stream-in-html > dependency-graph.html && open dependency-graph.html",
    "size": "pnpm -r --if-present --no-bail size",
    "------------------- dependencies -------------------": "noop",
    "outdated": "pnpm outdated -r",
    "------------------- cleanup -------------------": "noop",
    "clean:build": "rimraf --glob 'apps/*/{.next,out,dist,.vercel,tsconfig.tsbuildinfo,next-env.d.ts}' 'packages/*/{dist,tsconfig.tsbuildinfo}'",
    "clean:tests": "rimraf --glob 'apps/*/{coverage,test-output,test-results,playwright-report}' 'packages/*/coverage' 'apps/*/*.lcov' 'packages/*/*.lcov'",
    "clean:node_modules": "rimraf --glob node_modules 'apps/*/node_modules' 'packages/*/node_modules'",
    "clean:all": "pnpm clean:build && pnpm clean:tests && pnpm clean:py && pnpm clean:node_modules",
    "clean:py": "uv run --directory python poe clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched",
    "*.css": "stylelint --fix",
    "*.md": "markdownlint-cli2 --fix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@lingual/i18n-check": "^0.9.3",
    "@size-limit/file": "^13.0.3",
    "@vvago/vale": "^3.17.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10",
    "eslint-config-biome": "^2.1.3",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.23.2",
    "rimraf": "^6.1.3",
    "size-limit": "^13.0.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "supabase": "^2.113.0",
    "typescript": "^6"
  }
}
