{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Oxlint is the only linter (docs/decision-records/0004). Biome formats; it no longer lints.
  // Started from `@oxlint/migrate` against the retired eslint.config.mjs, then adjusted so
  // that nothing ESLint or Biome enforced is lost. See the ADR for the coverage audit.
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "nextjs", "import", "vitest"],
  // Oxlint's native port has every Next.js rule except one; the Next.js ESLint plugin runs
  // through the JS plugin API for that rule alone. Aliased, because `nextjs` is native.
  "jsPlugins": [{ "name": "next-js", "specifier": "@next/eslint-plugin-next" }],
  // High-confidence rules, on by default in oxlint. It replaced Biome's recommended set (ADR 0004).
  "categories": {
    "correctness": "error",
  },
  // Browser and Node globals, as eslint-config-next declared them. Without `browser`, the
  // Next.js JS plugin cannot resolve `window` as a global and its rule never fires.
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
  },
  "settings": {
    "react": {
      "version": "19.3.0",
    },
  },
  "rules": {
    // ---- House rules (.claude/rules/coding-standards.md) -------------------------------
    // Oxlint also checks type parameters, which ESLint's id-length did not: `<T>` fails.
    "id-length": [
      "error",
      { "min": 2, "exceptions": ["_"], "exceptionPatterns": ["^_"], "properties": "never" },
    ],
    "func-style": ["error", "expression", { "allowArrowFunctions": true }],
    "prefer-const": "error",
    "no-var": "error",
    "prefer-spread": "error",
    "no-unused-expressions": "error",
    "typescript/no-explicit-any": "warn",

    // ---- Accessibility: eslint-plugin-jsx-a11y recommended, all 31 rules native ---------
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",

    // ---- React and the React Compiler (eslint-plugin-react-hooks 7 recommended) ---------
    // rules-of-hooks sits in oxlint's `pedantic` category, so it must be named explicitly.
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/preserve-manual-memoization": "error",
    "react/incompatible-library": "warn",
    "react/immutability": "error",
    "react/globals": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/error-boundaries": "error",
    "react/purity": "error",
    "react/unsupported-syntax": "warn",
    "react/display-name": "error",
    "react/jsx-no-undef": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/no-string-refs": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "off",
    "react/no-unsafe": "off",
    "react/react-in-jsx-scope": "off",

    // ---- Next.js (eslint-config-next core-web-vitals) --------------------------------
    "nextjs/google-font-display": "warn",
    "nextjs/google-font-preconnect": "warn",
    "nextjs/inline-script-id": "error",
    "nextjs/next-script-for-ga": "warn",
    "nextjs/no-assign-module-variable": "error",
    "nextjs/no-async-client-component": "warn",
    "nextjs/no-before-interactive-script-outside-document": "warn",
    "nextjs/no-css-tags": "warn",
    "nextjs/no-document-import-in-page": "error",
    "nextjs/no-duplicate-head": "error",
    "nextjs/no-head-element": "warn",
    "nextjs/no-head-import-in-document": "error",
    "nextjs/no-img-element": "warn",
    "nextjs/no-page-custom-font": "warn",
    "nextjs/no-script-component-in-head": "error",
    "nextjs/no-styled-jsx-in-document": "warn",
    "nextjs/no-sync-scripts": "error",
    "nextjs/no-title-in-document-head": "warn",
    "nextjs/no-typos": "warn",
    "nextjs/no-unwanted-polyfillio": "warn",
    // App Router only: there is no pages/ directory for this rule to resolve.
    "nextjs/no-html-link-for-pages": "off",
    "next-js/no-location-assign-relative-destination": "error",

    // ---- TypeScript (eslint-config-next/typescript, non-type-aware) ---------------------
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/triple-slash-reference": "error",
    "import/no-anonymous-default-export": "warn",

    // ---- Vitest: correctness rules that misread this repo's Vitest idioms ---------------
    // Vitest accepts `expect(value, message)`; this rule assumes Jest's single argument.
    "vitest/valid-expect": "off",
    // Fires on `.not.toThrow()`, where a message has nothing to match.
    "vitest/require-to-throw-message": "off",
    // Rejects computed titles built from `it.each` data, which are always strings.
    "vitest/valid-title": "off",
    // Asserting after a type-narrowing `if (result.ok)` is deliberate in these tests.
    "vitest/no-conditional-expect": "off",
    // A typing preference never enforced here; untyped vi.fn() mocks are the norm.
    "vitest/require-mock-type-parameters": "off",
    // Helpers that assert internally count as assertions.
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "closeOverlay"] }],
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/next-env.d.ts",
    "**/storybook-static/**",
    "**/coverage/**",
    // coverage.py's HTML report: its bundled viewer JS is not ours.
    "**/htmlcov/**",
    // The uv virtualenv: matplotlib's web backend ships JS we do not own.
    "**/.venv/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/.agents/skills/**",
    // Supabase CLI runtime state, including a minified edge-runtime bootstrap.
    "supabase/.temp/**",
  ],
}
