# Python workspace environment — copy to .env and fill in.
#
# Secrets are resolved through the `artloupe.config` seam: the macOS keychain locally,
# platform env in deployment. Never commit a real key here.

# --- Model providers ---------------------------------------------------------
# Anthropic (reasoning, critique, prose):
# ANTHROPIC_API_KEY=sk-ant-...
# OpenAI (embeddings):
# OPENAI_API_KEY=sk-...

# Where the config seam looks first. "keychain" (default on macOS) or "env".
# ARTLOUPE_SECRET_SOURCE=keychain
# ARTLOUPE_KEYCHAIN_SERVICE=art-loupe

# --- Environment -------------------------------------------------------------
# local | ci | production. Gates behaviour that must never run outside development.
# APP_ENV=local

# --- Database ----------------------------------------------------------------
# Local Supabase, from `pnpm supabase status`. Required only by the backends that
# read it; the defaults are in-memory so tests and CI stay hermetic.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Retrieval backend: unset (default) uses committed fixtures; `pgvector` reads the
# embedded corpus from Postgres.
# ARTLOUPE_RETRIEVAL_BACKEND=pgvector

# --- Auth (artloupe.auth) ----------------------------------------------------
# Python never handles a credential: the Next.js apps authenticate against Supabase
# directly and forward the access token, which these settings verify. See ADR 0002.
#
# SUPABASE_URL is shared with the apps. The anon key is public by design; the
# service-role key is NEVER read by this library.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<local anon key from `pnpm supabase status`>

# Set ONLY for a project still on the legacy HS256 shared secret — which is what a local
# `supabase start` issues. When set, verification is symmetric, meaning this process holds
# material that can also SIGN tokens. Leave unset on projects with JWT signing keys so
# verification uses the published JWKS and holds no secret at all.
# SUPABASE_JWT_SECRET=<local jwt secret from `pnpm supabase status`>

# Expected `aud` claim. Supabase issues "authenticated" for signed-in users.
# ARTLOUPE_JWT_AUDIENCE=authenticated

# How long a fetched JWKS document is reused before refetching, in seconds.
# ARTLOUPE_JWKS_CACHE_SECONDS=600

# --- Metering and run guards (artloupe.metering) ------------------------------
# Where a finished run's per-node ledger goes. "memory" (default) keeps it in the
# process, which is correct for tests and useless to operations; "postgres" writes
# `public.run_node_metrics`, which is what the cost dashboard reads.
# ARTLOUPE_METERING=postgres

# The caps on one graph run. Every one of these is configuration rather than a
# constant so a demo can tighten a ceiling and show the hard stop firing.
#
# Supersteps in one run. 25 is LangGraph's own default, passed explicitly.
# ARTLOUPE_RUN_RECURSION_LIMIT=25
# Executions of any single node in one run — fires earlier than the recursion limit
# and names the node that is looping.
# ARTLOUPE_RUN_NODE_VISIT_LIMIT=10
# Deadline for one run. NFR-03 budgets p95 45-60s cold for a full plan graph.
# ARTLOUPE_RUN_WALL_CLOCK_SECONDS=120
# The NFR-04 per-project plan budget, input and output tokens together. Chat credits
# (NFR-11) are a separate meter and neither can stop the other.
# ARTLOUPE_PLAN_TOKEN_CEILING=250000

# --- Agent service -----------------------------------------------------------
# Port the agent's HTTP service binds. The apps read it as ARTLOUPE_AGENT_URL.
# ARTLOUPE_AGENT_PORT=8080

# --- Dev AI-call cache -------------------------------------------------------
# Opt-in read-through cache over external AI calls so iterating doesn't re-spend
# tokens on identical calls. Off by default; inert in CI and production. On-disk in
# the gitignored python/.cache — delete that directory to reset. A dev-ergonomics
# token-saver, NOT a production caching layer.
# ARTLOUPE_AI_CACHE=1
# ARTLOUPE_AI_CACHE_DIR=/path/to/cache

# --- Logging -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace
# LOG_LEVEL=info
