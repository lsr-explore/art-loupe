# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example
# Committed on purpose: hermetic e2e credentials, no secrets. See apps/*/.env.test.
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# storybook
storybook-static/

# test output
test-output/
test-results/
*.lcov

# playwright
playwright-report/

# dependency graph artifact
dependency-graph.html

# VS Code Counter output (generated LOC reports)
.VSCodeCounter/

# python (uv workspace)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# vale prose styles pulled by `vale sync` — reinstallable dev tooling, not vendored, on the
# same reasoning as the agent skills below. The curated ArtLoupe vocabulary under config/ IS
# tracked: it is this project's own word list, not a downloaded style.
/.vale/styles/*
!/.vale/styles/config/
/.vale/styles/config/*
!/.vale/styles/config/vocabularies/

# third-party agent skills — reinstallable dev tooling, not vendored.
# Source of truth is skills-lock.json; reinstall via the skills CLI. Committing a skill
# means redistributing it, so check its license first — not every published skill is
# permissive. See .agents/skills/README.md for the reinstall command and the caveats.
/.agents/skills/*
!/.agents/skills/README.md
# First-party skills authored in this repo ARE tracked; third-party ones stay ignored.
# Each first-party skill needs its own negation line — add one when you author a skill,
# or it ships as a dangling reference from CLAUDE.md / the rules.
/.claude/skills/*
!/.claude/skills/wrap/
!/.claude/skills/ship/
!/.claude/skills/backlog/
!/.claude/skills/tag-tests/

# macOS finder metadata
.DS_Store
